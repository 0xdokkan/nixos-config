// fastfetch — la config è generata da home/shell.nix a partire da questo
// file. Le IMMAGINI stanno in dotfiles/fastfetch/images/: quella nel logo
// qui sotto è un placeholder (bg3.jpg di Candy), mettici la tua.
//
// Perché le immagini funzionano: kitty parla il "kitty graphics protocol",
// e fastfetch con "type": "kitty-direct" gli passa il file da mostrare.
// In un terminale che non lo supporta (tty, ssh) fastfetch ripiega da
// solo sul logo ASCII di NixOS.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "@IMAGES@/example.jpg",
    "width": 30,
    "height": 15,
    "padding": { "top": 1, "left": 2, "right": 2 }
  },
  "display": {
    "separator": " › "
  },
  // I moduli sono gli stessi dell'output di default che c'è su Arch, in
  // quest'ordine. Aggiungi/togli/riordina a piacere: lista completa con
  // `fastfetch --list-modules`.
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "locale",
    "break",
    "colors"
  ]
}
