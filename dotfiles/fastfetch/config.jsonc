// fastfetch — la config è generata da home/shell.nix a partire da questo
// file.
//
// Il logo è il fiocco NixOS 3D di home/fastfetch-spin.nix: @LOGO@ diventa
// il blocco "logo" con il fotogramma frontale (file-raw, 44x20, margini).
// Lanciato senza argomenti in un terminale, `fastfetch` fa girare lo
// stesso fiocco accanto a queste info; con argomenti o in una pipe lo
// mostra fermo.
//
// Per tornare a un'immagine di dotfiles/fastfetch/images/ (solo kitty:
// "kitty graphics protocol"; altrove fastfetch ripiega sul logo ASCII)
// sostituisci @LOGO@ con
//   { "type": "kitty-direct", "source": "@IMAGES@/example.jpg",
//     "width": 30, "height": 15, "padding": { "top": 1, "left": 2, "right": 2 } }
// e togli `programs.fastfetch.package` da home/shell.nix (niente animazione).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": @LOGO@,
  "display": {
    "separator": " › "
  },
  // I moduli sono gli stessi dell'output di default che c'è su Arch, in
  // quest'ordine. Aggiungi/togli/riordina a piacere: lista completa con
  // `fastfetch --list-modules`.
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "locale",
    "break",
    "colors"
  ]
}
