// ╔══════════════════════════════════════════════════════════════════════╗
// ║  niri config — migrato da Hyprland (HyDE)                            ║
// ║  data: 2026-05-10                                                    ║
// ║  modello workspace: dinamico scrollable (paradigma niri full)        ║
// ║                                                                      ║
// ║  Note importanti:                                                    ║
// ║   - In niri i workspace sono VERTICALI e dinamici. I bind Super+1..0 ║
// ║     usano `focus-workspace N` per raggiungere i workspace esistenti. ║
// ║   - Le finestre nel workspace si organizzano in COLONNE che          ║
// ║     scrollano orizzontalmente. Dentro una colonna ci possono essere  ║
// ║     più finestre impilate verticalmente.                             ║
// ║   - I gesti touchpad sono integrati: 3-dita orizzontale = scroll     ║
// ║     colonne, 3-dita verticale = cambio workspace.                    ║
// ║   - niri ricarica la config automaticamente quando il file cambia.   ║
// ╚══════════════════════════════════════════════════════════════════════╝


// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PER-HOST — generato da nix nella stessa cartella (layout tastiera)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

include "host.kdl"

// Un workspace nominato resta disponibile anche quando è vuoto.
// È visibile nella barra/overview: NON è uno "special" nascosto di Hyprland.
// Gli altri workspace restano dinamici; i loro indici possono cambiare.
workspace "scratch"


// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INPUT — tastiera, touchpad, mouse
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

input {
    keyboard {
        xkb {
            // Il layout NON è qui: questo file è condiviso tra fisso (US)
            // e armoredcoreVIP (IT). Sta in host.kdl, generato da home-manager
            // dal valore di services.xserver.xkb.layout dell'host
            // (vedi home/niri-configs.nix). Con "it,us" keyboardswitch.sh
            // (Mod+K) cicla tra i due.
        }
        // Equivalente di numlock_by_default = true
        numlock
        repeat-delay 600
        repeat-rate 25
    }

    touchpad {
        // tap-to-click
        tap
        // dwt (disable while typing) — equivalente al comportamento HyDE
        dwt
        // hyprland aveva natural_scroll = no
        // (niri di default usa natural-scroll, lo lasciamo OFF per parità)
        // natural-scroll
        accel-speed 0.0
        accel-profile "adaptive"
        // tap-button-map "left-right-middle"
    }

    mouse {
        // hyprland aveva force_no_accel = 1
        accel-profile "flat"
        accel-speed 0.0
    }

    // hyprland: follow_mouse = 1
    // In niri il focus-on-hover è opt-in:
    // focus-follows-mouse max-scroll-amount="0%"

    // Niente warp del mouse al cambio workspace
    workspace-auto-back-and-forth

    // touchpad gestures: niri ha già swipe a 3 dita built-in.
    // Niente da configurare per imitare workspace_swipe di hyprland.

    // Mouse drag-to-move/resize finestre tile è limitato in niri:
    // funziona solo su finestre floating con Mod+left-click-drag e
    // Mod+right-click-drag (configurato nei `binds` sotto).
}


// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// OUTPUT — singolo monitor, auto-detect
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Niri rileva il monitor automaticamente. Sblocca ed edita questo blocco
// solo se vuoi forzare risoluzione/refresh/scale specifici. Per scoprire
// il nome del tuo output, lancia: niri msg outputs
//
// output "eDP-1" {
//     mode "1920x1080@60.000"
//     scale 1.0
//     position x=0 y=0
//     variable-refresh-rate on-demand=true
// }


// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LAYOUT — gap, larghezze colonna, focus ring, border
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

layout {
    gaps 8
    background-color "transparent"
    center-focused-column "never"

    // Larghezze preimpostate cicliche (premi il bind switch-preset-column-width)
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    // Larghezza di default quando si apre una nuova colonna
    default-column-width { proportion 0.5; }

    // Focus ring (l'evidenziatore della finestra attiva)
    focus-ring {
        width 2
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    // Border vero e proprio (off di default, il focus-ring basta)
    border {
        off
    }

    // Indicatore di posizione di inserimento quando muovi colonne
    insert-hint {
        color "#ffc87f80"
    }

    struts {
        // se waybar copre qualcosa, regola qui
        // left 64
        // right 64
    }

    // Empty workspaces sopra il primo (utile in modalità dinamica)
    // empty-workspace-above-first
}

// hyprland: disable_hyprland_logo + disable_splash_rendering
// In niri non c'è logo splash, niente da fare.

// Preferisci finestre senza decorazioni client-side
prefer-no-csd

// Path screenshot (sostituisce screenshot.sh per il bind nativo)
screenshot-path "~/Pictures/Screenshots/screenshot from %Y-%m-%d %H-%M-%S.png"

// Cursor: hyprland aveva no_hardware_cursors per nvidia
cursor {
    hide-when-typing
    hide-after-inactive-ms 2000
}

// Hot corners disattivati per evitare attivazioni accidentali dell'overview
hotkey-overlay {
    skip-at-startup
}


// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SPAWN AT STARTUP — equivalente di exec-once di hyprland
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// La sessione niri gestisce l'ambiente systemd/D-Bus e l'avvio dei portali.
// Le variabili delle app sono in hosts/common.nix: nessun restart manuale.
// udiskie: gestione media rimovibili (Noctalia non lo include)
spawn-at-startup "udiskie" "--no-automount" "--smart-tray"
// Noctalia gestisce direttamente cronologia clipboard e filtro luce blu.

// === Funzioni gestite da Noctalia ===
//   waybar              → barra
//   dunst               → notifiche
//   blueman-applet      → control-center (bluetooth)
//   nm-applet           → control-center (network)
//   polkitkdeauth.sh    → agente polkit
//   batterynotify.sh    → notifiche batteria
//   awww-daemon + restore → motore wallpaper
//
// Noctalia NON va in spawn-at-startup: il servizio systemd viene avviato
// insieme alla sessione grafica, evitando istanze duplicate.


// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENVIRONMENT — identità della sessione
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Le variabili Qt/GTK/Firefox sono in hosts/common.nix per raggiungere
// anche i servizi systemd e il launcher Noctalia. Il PATH utente è in home/shell.nix.

environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    XDG_SESSION_DESKTOP "niri"
    // (rimosse le env var nvidia: GBM_BACKEND, __GLX_VENDOR_LIBRARY_NAME,
    //  LIBVA_DRIVER_NAME, __GL_VRR_ALLOWED, NIRI_DISABLE_HARDWARE_CURSORS —
    //  il T470s è Intel HD 620, su iGPU non servono e alcune farebbero danni)
}


// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ANIMAZIONI — adattamento delle bezier "wind/winIn/winOut" di HyDE
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

animations {
    // Globale: 1.0 = velocità nominale. Aumenta per rallentare tutto.
    slowdown 1.0

    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-open {
        duration-ms 200
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
}


// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// WINDOW RULES — porting di tutte le windowrule HyDE (62 regole)
// Match: in niri si usano `app-id` (= class wayland) e `title` (regex).
// Per app X11/xwayland l'app-id potrebbe differire — controlla con:
//   niri msg --json windows
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// --- Regola GLOBALE: blur + corner radius + fix tint focus-ring ---
// 1) Blur globale: grazie a xray niri lo calcola una volta sul wallpaper.
// 2) draw-border-with-background false: fix per la sfumatura azzurra che
//    tracima attraverso le finestre semitrasparenti (Steam, Discord, ecc.).
//    Senza questo, il colore del focus-ring si vede dietro al contenuto
//    trasparente e tinge la finestra di azzurro quando ha il focus.
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
    draw-border-with-background false
    background-effect {
        blur true
    }
}

// --- Browser e editor ---
window-rule {
    match app-id="firefox"
    opacity 0.90
    background-effect { blur true; }
}
window-rule {
    match app-id="^[Bb]rave-browser$"
    opacity 0.90
    background-effect { blur true; }
}
window-rule {
    match app-id="code-oss"
    opacity 0.80
    background-effect { blur true; }
}
window-rule {
    match app-id="^[Cc]ode$"
    opacity 0.80
    background-effect { blur true; }
}
window-rule {
    match app-id="code-url-handler"
    opacity 0.80
    background-effect { blur true; }
}
window-rule {
    match app-id="code-insiders-url-handler"
    opacity 0.80
    background-effect { blur true; }
}

// --- Terminale & file manager ---
window-rule {
    match app-id="kitty"
    opacity 0.80
    background-effect { blur true; }
}
window-rule {
    match app-id="org.gnome.Nautilus"
    opacity 0.80
    background-effect { blur true; }
}

// --- Tool che vogliamo floating ---
window-rule {
    match app-id="org.kde.ark"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="nwg-look"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="qt5ct"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="qt6ct"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="kvantummanager"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="org.pulseaudio.pavucontrol"
    opacity 0.75
    open-floating true
}
window-rule {
    match app-id="blueman-manager"
    opacity 0.75
    open-floating true
}
window-rule {
    match app-id="nm-applet"
    opacity 0.75
    open-floating true
}
window-rule {
    match app-id="nm-connection-editor"
    opacity 0.75
    open-floating true
}

// --- Polkit & portali ---
window-rule {
    match app-id="org.kde.polkit-kde-authentication-agent-1"
    opacity 0.75
    open-floating true
}
window-rule {
    match app-id="polkit-gnome-authentication-agent-1"
    opacity 0.75
}
window-rule {
    match app-id="org.freedesktop.impl.portal.desktop.gtk"
    opacity 0.75
}
// (rimosso) match app-id="org.freedesktop.impl.portal.desktop.hyprland"
// — non più rilevante, ora usiamo xdg-desktop-portal-gtk

// --- Steam & Spotify ---
window-rule {
    match app-id="^[Ss]team$"
    opacity 0.70
}
window-rule {
    match app-id="steamwebhelper"
    opacity 0.70
}
window-rule {
    match app-id="^[Ss]potify$"
    opacity 0.70
}

// --- App GTK varie ---
window-rule {
    match app-id="com.github.rafostar.Clapper"
    opacity 0.90
    open-floating true
}
window-rule {
    match app-id="com.github.tchx84.Flatseal"
    opacity 0.80
}
window-rule {
    match app-id="hu.kramo.Cartridges"
    opacity 0.80
}
window-rule {
    match app-id="com.obsproject.Studio"
    opacity 0.80
}
window-rule {
    match app-id="gnome-boxes"
    opacity 0.80
}
window-rule {
    match app-id="vesktop"
    opacity 0.80
}
window-rule {
    match app-id="discord"
    opacity 0.80
}
window-rule {
    match app-id="WebCord"
    opacity 0.80
}
window-rule {
    match app-id="ArmCord"
    opacity 0.80
}
window-rule {
    match app-id="app.drey.Warp"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="net.davidotek.pupgui2"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="yad"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="Signal"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="io.github.alainm23.planify"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="io.gitlab.theevilskeleton.Upscaler"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="com.github.unrud.VideoDownloader"
    opacity 0.80
}
window-rule {
    match app-id="io.gitlab.adhami3310.Impression"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="io.missioncenter.MissionCenter"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="io.github.flattool.Warehouse"
    opacity 0.80
}

// --- Floating per titolo (modali/dialoghi) ---
window-rule {
    match title="^About Mozilla Firefox$"
    open-floating true
}
window-rule {
    match app-id="firefox" title="^Picture-in-Picture$"
    open-floating true
}
window-rule {
    match app-id="firefox" title="^Library$"
    open-floating true
}
window-rule {
    match app-id="kitty" title="^top$"
    open-floating true
}
window-rule {
    match app-id="kitty" title="^btop$"
    open-floating true
}
window-rule {
    match app-id="kitty" title="^htop$"
    open-floating true
}
window-rule {
    match app-id="vlc"
    open-floating true
}
window-rule {
    match app-id="eog"
    open-floating true
}

// --- Dialoghi modali comuni ---
window-rule {
    match title="^Open$"
    open-floating true
}
window-rule {
    match title="^Choose Files$"
    open-floating true
}
window-rule {
    match title="^Save As$"
    open-floating true
}
window-rule {
    match title="^Confirm to replace files$"
    open-floating true
}
window-rule {
    match title="^File Operation Progress$"
    open-floating true
}
window-rule {
    match app-id="xdg-desktop-portal-gtk"
    open-floating true
}


// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BLUR globale — applicato dove i background-effect lo richiedono
// xray on di default = blur calcolato una volta sul wallpaper, riusato
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// (eventuale blur globale da regolare se troppo intenso/leggero)
// blur {
//     passes 4
//     radius 20
// }


// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LAYER RULES — blur sui layer (rofi, dunst, swaync)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// === Noctalia 5: namespace nativi (non quelli Quickshell della v4) ===
// Noctalia richiede il blur tramite il protocollo ext-background-effect.
// I namespace sono controllati contro i sorgenti della versione nel lock.

// Shadow sotto la bar e il dock
layer-rule {
    match namespace="^noctalia-bar-.*$"
}

layer-rule {
    match namespace="^noctalia-dock$"
    shadow {
        on
        softness 40
        spread 5
        offset x=0 y=5
        draw-behind-window true
        color "#00000064"
    }
}
// Privacy negli screencast niri: clipboard, Polkit e credenziali Wi-Fi/BT
// usano gli STESSI due layer degli altri pannelli. Non sono distinguibili
// per contenuto: oscuriamo quindi anche launcher e control-center interi.
// Barra, dock e finestra Settings restano visibili. I popup xdg figli
// seguono la superficie genitore; il click-shield non contiene dati.
layer-rule {
    match namespace="^noctalia-panel$"
    match namespace="^noctalia-attached-panel$"
    block-out-from "screencast"
    place-within-backdrop true
}

// Il pulsante Wi-Fi QR usa nmcli in un terminale dedicato: contiene la
// password della rete, quindi non deve comparire negli screencast.
window-rule {
    match app-id=r#"^noctalia-wifi-qr$"# title=r#"^Wi-Fi QR$"#
    block-out-from "screencast"
    open-floating true
}

// === Layer rule legacy (in caso rofi/dunst venissero comunque chiamati) ===
// Le tengo come safety net: se uno script HyDE non patchato lancia rofi,
// almeno il blur c'è. Non sono attive in flusso normale (Noctalia le sostituisce).
layer-rule {
    match namespace="^rofi$"
    place-within-backdrop true
    background-effect { blur true; }
}
layer-rule {
    match namespace="^dunst$"
    background-effect { blur true; }
}


// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BIND — keybindings tradotti dalla tua keybindings.conf
// Convenzioni di mapping:
//   $mainMod (Super) → Mod
//   exec → spawn (con array di args)
//   movefocus l/r/u/d → focus-column-{left,right} + focus-window-{up,down}
//   workspace 1..0 → focus-workspace 1..10
//   togglegroup → toggle-column-tabbed-display
//   togglespecialworkspace → toggle-overview (workaround)
//   togglesplit → consume-window-into-column (rimappato)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

binds {
    // ───── HOTKEY OVERLAY (mostra tutti i bind al volo) ─────
    Mod+Shift+Slash { show-hotkey-overlay; }

    // ───── Noctalia: Control center ─────
    Mod+Shift+P hotkey-overlay-title="Control center" {
        spawn "noctalia" "msg" "panel-toggle" "control-center"
    }

    // ───── Window/Session actions ─────
    Mod+Q hotkey-overlay-title="Close window (anti-Steam)" {
        spawn "sh" "-c" "$HOME/.config/niri/scripts/dontkillsteam.sh"
    }
    Alt+F4 { spawn "sh" "-c" "$HOME/.config/niri/scripts/dontkillsteam.sh"; }
    Mod+Delete { quit; }
    Mod+W hotkey-overlay-title="Toggle floating" { toggle-window-floating; }
    Mod+G hotkey-overlay-title="Toggle column tabbed" { toggle-column-tabbed-display; }
    Alt+Return hotkey-overlay-title="Fullscreen" { fullscreen-window; }
    Mod+L hotkey-overlay-title="Lock screen (Noctalia)" {
        spawn "noctalia" "msg" "session" "lock"
    }
    Mod+Shift+F hotkey-overlay-title="Toggle floating + center" {
        spawn "sh" "-c" "$HOME/.config/niri/scripts/windowpin.sh"
    }
    Mod+Backspace hotkey-overlay-title="Power menu (Noctalia)" {
        spawn "noctalia" "msg" "panel-toggle" "session"
    }
    // Toggle barra principale (era toggle waybar)
    Ctrl+Alt+W hotkey-overlay-title="Toggle Noctalia bar" {
        spawn "noctalia" "msg" "bar-toggle"
    }

    // ───── Application shortcuts ─────
    Mod+T { spawn "kitty"; }
    // File manager separato dalla ricerca file (Noctalia dmenu + fd).
    Mod+E { spawn "nautilus" "--new-window"; }
    Mod+Shift+E hotkey-overlay-title="Search files (Noctalia)" {
        spawn "bash" "-c" "exec \"$HOME/.config/niri/scripts/filesearch.sh\""
    }
    // era `code`: ora l'editor è neovim dentro kitty
    Mod+C hotkey-overlay-title="Neovim" { spawn "kitty" "nvim"; }
    Mod+F { spawn "firefox"; }
    // System monitor — sostituisce sysmonlaunch.sh con un launcher diretto
    Ctrl+Shift+Escape hotkey-overlay-title="System monitor" {
        spawn "kitty" "-e" "htop"
    }

    // ───── Noctalia: Launcher / Notifications / Clipboard ─────
    // App, emoji, finestre e calcolatrice; ricerca file su Mod+Shift+E.
    Mod+Space hotkey-overlay-title="Launcher (Noctalia)" {
        spawn "noctalia" "msg" "panel-toggle" "launcher"
    }
    Mod+A hotkey-overlay-title="Launcher" {
        spawn "noctalia" "msg" "panel-toggle" "launcher"
    }
    Mod+Tab hotkey-overlay-title="Launcher" {
        spawn "noctalia" "msg" "panel-toggle" "launcher"
    }
    // Notification center
    Mod+N hotkey-overlay-title="Notifications" {
        spawn "noctalia" "msg" "panel-toggle" "control-center" "notifications"
    }
    Mod+Shift+N hotkey-overlay-title="Dismiss popups" {
        spawn "noctalia" "msg" "notification-clear-active"
    }
    // Do Not Disturb
    Mod+Ctrl+N hotkey-overlay-title="Toggle DND" {
        spawn "noctalia" "msg" "notification-dnd-toggle"
    }

    // ───── Noctalia: Audio (sostituisce volumecontrol.sh) ─────
    Alt+F10 allow-when-locked=true {
        spawn "noctalia" "msg" "volume-mute"
    }
    F11 allow-when-locked=true {
        spawn "noctalia" "msg" "volume-down" "5"
    }
    F12 allow-when-locked=true {
        spawn "noctalia" "msg" "volume-up" "5"
    }
    XF86AudioMute allow-when-locked=true {
        spawn "noctalia" "msg" "volume-mute"
    }
    // Mic mute: conserva il controllo diretto WirePlumber anche senza shell.
    XF86AudioMicMute allow-when-locked=true {
        spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn "noctalia" "msg" "volume-down" "5"
    }
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn "noctalia" "msg" "volume-up" "5"
    }

    // ───── Noctalia: Media (MPRIS) ─────
    XF86AudioPlay allow-when-locked=true {
        spawn "noctalia" "msg" "media" "toggle"
    }
    XF86AudioPause allow-when-locked=true {
        spawn "noctalia" "msg" "media" "toggle"
    }
    XF86AudioNext allow-when-locked=true {
        spawn "noctalia" "msg" "media" "next"
    }
    XF86AudioPrev allow-when-locked=true {
        spawn "noctalia" "msg" "media" "previous"
    }

    // ───── Noctalia: Brightness (passi del 5%) ─────
    XF86MonBrightnessUp allow-when-locked=true {
        spawn "noctalia" "msg" "brightness-up" "current" "5%"
    }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn "noctalia" "msg" "brightness-down" "current" "5%"
    }

    // ───── Filtro luce blu (Noctalia; temperatura e orari dalla sua UI) ─────
    // IPC idempotenti aggiunti dalla patch 5.2.1: on/off anche fuori orario
    // e dopo un cambio dalla UI, senza toccare le preferenze salvate.
    Alt+F8 hotkey-overlay-title="Night mode on (Noctalia)" {
        spawn "noctalia" "msg" "nightlight-force-on"
    }
    Alt+F9 hotkey-overlay-title="Night mode off (Noctalia)" {
        spawn "noctalia" "msg" "nightlight-force-off"
    }

    // ───── Movimento tra finestre/colonne (in stile hyprland mapping) ─────
    // Frecce: orizzontale = colonne, verticale = finestre dentro colonna
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    // Alt+Tab era "movefocus, d" → focus next finestra (vertical-or-horizontal)
    Alt+Tab   { focus-window-or-workspace-down; }

    // Niente vim-keys di default: nella tua HyDE Mod+J e Mod+K hanno
    // già funzioni (togglesplit e keyboardswitch). Se vuoi i vim-keys
    // crea bind alternativi tipo Mod+Y/U/I/O o cambia il leader.

    // ───── Switch workspace numerati (Super+1..0) ─────
    // In modalità dinamica niri crea il workspace al volo.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    // ───── Cambio workspace relativo (Super+Ctrl+arrow) ─────
    // NB: in niri i workspace sono verticali. Mappo Right→down, Left→up
    // per mantenere il muscle memory hyprland (era r+1 / r-1).
    Mod+Ctrl+Right { focus-workspace-down; }
    Mod+Ctrl+Left  { focus-workspace-up; }
    // ex "workspace, empty" — in niri c'è sempre un workspace vuoto in fondo
    Mod+Ctrl+Down { focus-workspace-down; }
    Mod+Ctrl+Up   { focus-workspace-up; }

    // ───── Resize finestre/colonne ─────
    // hyprland: $mainMod+Shift+arrow → resizeactive
    Mod+Shift+Right { set-column-width "+30"; }
    Mod+Shift+Left  { set-column-width "-30"; }
    Mod+Shift+Up    { set-window-height "-30"; }
    Mod+Shift+Down  { set-window-height "+30"; }
    // Cicla tra le preset-column-widths
    Mod+R { switch-preset-column-width; }
    // NB: Mod+Shift+R è già usato dal wallbash menu (più sotto).
    //      reset-window-height è disponibile su Mod+X.
    // Massimizza la colonna in larghezza
    Mod+M { maximize-column; }
    Mod+Shift+M { fullscreen-window; }

    // ───── Move-to-workspace (Super+Shift+1..0) ─────
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // ───── Move-to-workspace relativo (Super+Ctrl+Alt) ─────
    Mod+Ctrl+Alt+Right { move-column-to-workspace-down; }
    Mod+Ctrl+Alt+Left  { move-column-to-workspace-up; }

    // ───── Move active window (Super+Shift+Ctrl+arrow) ─────
    // hyprland: $moveactivewindow custom (move floating o tile a seconda)
    // niri: muove colonne orizzontalmente, finestre verticalmente
    Mod+Shift+Ctrl+Left  { move-column-left; }
    Mod+Shift+Ctrl+Right { move-column-right; }
    Mod+Shift+Ctrl+Up    { move-window-up; }
    Mod+Shift+Ctrl+Down  { move-window-down; }

    // ───── Move-silent (Super+Alt+1..0) ─────
    // In niri "silent" = senza seguire la finestra (focus rimane qui).
    // L'azione è la stessa ma usando l'overload focus=false.
    Mod+Alt+1 { move-column-to-workspace 1 focus=false; }
    Mod+Alt+2 { move-column-to-workspace 2 focus=false; }
    Mod+Alt+3 { move-column-to-workspace 3 focus=false; }
    Mod+Alt+4 { move-column-to-workspace 4 focus=false; }
    Mod+Alt+5 { move-column-to-workspace 5 focus=false; }
    Mod+Alt+6 { move-column-to-workspace 6 focus=false; }
    Mod+Alt+7 { move-column-to-workspace 7 focus=false; }
    Mod+Alt+8 { move-column-to-workspace 8 focus=false; }
    Mod+Alt+9 { move-column-to-workspace 9 focus=false; }
    Mod+Alt+0 { move-column-to-workspace 10 focus=false; }

    // ───── Mouse wheel = cambia workspace (come hyprland) ─────
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Shift+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    // ───── Mouse drag (move/resize) ─────
    // In niri Mod+ButtonLeft/Right drag funziona automaticamente sui float;
    // i bind expliciti sotto sono per parità con i tuoi `bindm`.
    // Mod+MouseLeft  = move (built-in in niri, niente bind)
    // Mod+MouseRight = resize (built-in in niri, niente bind)
    Mod+Z hotkey-overlay-title="Move floating" { toggle-window-floating; }
    Mod+X hotkey-overlay-title="Reset col width" { reset-window-height; }

    // ───── Scratch nominato (non uno special workspace nascosto) ─────
    // Super+S → overview; Super+Alt+S → invia la colonna senza seguirla;
    // Super+Ctrl+S → raggiungi scratch (sullo stesso monitor, ripremi per
    // tornare indietro grazie a workspace-auto-back-and-forth).
    // Il nome è stabile, l'indice no.
    Mod+S hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+Alt+S hotkey-overlay-title="Scratch (no focus)" {
        move-column-to-workspace "scratch" focus=false
    }
    Mod+Ctrl+S hotkey-overlay-title="Focus scratch" { focus-workspace "scratch"; }

    // ───── Group navigation (era changegroupactive b/f) ─────
    // niri: tra finestre in colonna tabbed = focus up/down
    Mod+Ctrl+H { focus-window-up; }
    Mod+Ctrl+L { focus-window-down; }

    // ───── Toggle split (era Super+J) ─────
    // niri non ha dwindle/split. Rimappo a "consume": pulla la finestra
    // della colonna a destra dentro la colonna corrente.
    Mod+Period { consume-or-expel-window-right; }
    Mod+Comma  { consume-or-expel-window-left; }

    // ───── Screenshot ─────
    // Bind nativi di niri: screenshot interactive UI / screen / window
    Mod+P hotkey-overlay-title="Screenshot region" { screenshot; }
    // Screenshot region con editor — sostituisce screenshot.sh sf (HyDE)
    Mod+Ctrl+P hotkey-overlay-title="Screenshot region + editor" {
        spawn "sh" "-c" "grim -g \"$(slurp)\" - | swappy -f -"
    }
    // Screenshot dello schermo corrente (niri native) — sostituisce screenshot.sh p
    Mod+Alt+P hotkey-overlay-title="Screenshot monitor" { screenshot-screen; }
    Print hotkey-overlay-title="Screenshot screen" { screenshot-screen; }

    // ───── Noctalia: Wallpaper, Theme, Settings ─────
    Mod+Alt+Right hotkey-overlay-title="Next wallpaper" {
        spawn "noctalia" "msg" "wallpaper-next"
    }
    Mod+Alt+Left hotkey-overlay-title="Prev wallpaper" {
        spawn "noctalia" "msg" "wallpaper-previous"
    }
    Mod+Shift+W hotkey-overlay-title="Wallpaper picker" {
        spawn "noctalia" "msg" "panel-toggle" "wallpaper"
    }
    // Toggle dark/light: variante della palette, senza cambiare temi GTK/Qt.
    Mod+Shift+T hotkey-overlay-title="Toggle theme" {
        spawn "noctalia" "msg" "theme-mode-toggle"
    }
    // Settings UI di Noctalia
    Mod+Shift+R hotkey-overlay-title="Noctalia settings" {
        spawn "noctalia" "msg" "settings-toggle"
    }
    // Launcher (alias di Mod+A/Tab già sopra, solo per muscle memory HyDE)
    Mod+Shift+A hotkey-overlay-title="Launcher" {
        spawn "noctalia" "msg" "panel-toggle" "launcher"
    }
    // Clipboard manager Noctalia (cronologia nativa)
    Mod+V hotkey-overlay-title="Clipboard" {
        spawn "noctalia" "msg" "panel-toggle" "clipboard"
    }
    Mod+Shift+V hotkey-overlay-title="Clipboard" {
        spawn "noctalia" "msg" "panel-toggle" "clipboard"
    }
    // Lista processi: Noctalia mostra metriche, htop mantiene ricerca e kill.
    Mod+Shift+Escape hotkey-overlay-title="Process list" {
        spawn "kitty" "-e" "htop"
    }

    // ───── Game mode (lo script lavora ancora, swappa config niri) ─────
    Mod+Alt+G hotkey-overlay-title="Toggle game mode" {
        spawn "sh" "-c" "$HOME/.config/niri/scripts/gamemode.sh"
    }

    // ───── Keyboard layout switch (script niri-aware) ─────
    Mod+K hotkey-overlay-title="Switch keyboard layout" {
        spawn "sh" "-c" "$HOME/.config/niri/scripts/keyboardswitch.sh"
    }

    // ───── Keybinds cheatsheet ─────
    // niri ha già il suo overlay built-in: Mod+Shift+Slash
    // Lo lascio in mano a quello e libero Mod+Slash.

    // ───── Binding HyDE non usati ─────
    //   Mod+Alt+Up/Down (wbarconfgen)  → nessuno stile barra da ciclare
    //   Mod+Slash      (keybinds_hint) → uso Mod+Shift+Slash niri-native
}

// Mostra il wallpaper nella overview
layer-rule {
    match namespace="^noctalia-wallpaper$"
    match namespace="^noctalia-backdrop$"
    place-within-backdrop true
}

// ╔══════════════════════════════════════════════════════════════════════╗
// ║  Cose Hyprland che NON ho potuto mappare 1:1 — cerca "TODO" se vuoi   ║
// ║  cambiarle:                                                           ║
// ║   • togglespecialworkspace → overview e workspace nominato scratch   ║
// ║   • togglesplit (dwindle) → rimappato a consume-or-expel              ║
// ║   • windowpin.sh (pin globale) → diventa toggle-floating + center     ║
// ║   • workspace_swipe orizzontale → niri ha swipe verticale per ws e    ║
// ║     orizzontale per colonne. È INVERTITO rispetto ad hyprland.        ║
// ║   • opacity dynamic via hyprctl reload → niri ricarica auto su file   ║
// ║     change, gli script wallbash possono solo riscrivere config.kdl.   ║
// ╚══════════════════════════════════════════════════════════════════════╝
