// ╔══════════════════════════════════════════════════════════════════════╗
// ║  niri config — migrato da Hyprland (HyDE)                            ║
// ║  data: 2026-05-10                                                    ║
// ║  modello workspace: dinamico scrollable (paradigma niri full)        ║
// ║                                                                      ║
// ║  Note importanti:                                                    ║
// ║   - In niri i workspace sono VERTICALI e dinamici. I bind Super+1..0 ║
// ║     usano `focus-workspace N` che crea/raggiunge il workspace N.     ║
// ║   - Le finestre nel workspace si organizzano in COLONNE che          ║
// ║     scrollano orizzontalmente. Dentro una colonna ci possono essere  ║
// ║     più finestre impilate verticalmente.                             ║
// ║   - I gesti touchpad sono integrati: 3-dita orizzontale = scroll     ║
// ║     colonne, 3-dita verticale = cambio workspace.                    ║
// ║   - niri ricarica la config automaticamente quando il file cambia.   ║
// ╚══════════════════════════════════════════════════════════════════════╝


// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PER-HOST — generato da nix nella stessa cartella (layout tastiera)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

include "host.kdl"


// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INPUT — tastiera, touchpad, mouse
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

input {
    keyboard {
        xkb {
            // Il layout NON è qui: questo file è condiviso tra fisso (US)
            // e armoredcoreVIP (IT). Sta in host.kdl, generato da home-manager
            // dal valore di services.xserver.xkb.layout dell'host
            // (vedi home/niri-configs.nix). Con "it,us" keyboardswitch.sh
            // (Mod+K) cicla tra i due.
        }
        // Equivalente di numlock_by_default = true
        numlock
        repeat-delay 600
        repeat-rate 25
    }

    touchpad {
        // tap-to-click
        tap
        // dwt (disable while typing) — equivalente al comportamento HyDE
        dwt
        // hyprland aveva natural_scroll = no
        // (niri di default usa natural-scroll, lo lasciamo OFF per parità)
        // natural-scroll
        accel-speed 0.0
        accel-profile "adaptive"
        // tap-button-map "left-right-middle"
    }

    mouse {
        // hyprland aveva force_no_accel = 1
        accel-profile "flat"
        accel-speed 0.0
    }

    // hyprland: follow_mouse = 1
    // In niri il focus-on-hover è opt-in:
    // focus-follows-mouse max-scroll-amount="0%"

    // Niente warp del mouse al cambio workspace
    workspace-auto-back-and-forth

    // touchpad gestures: niri ha già swipe a 3 dita built-in.
    // Niente da configurare per imitare workspace_swipe di hyprland.

    // Mouse drag-to-move/resize finestre tile è limitato in niri:
    // funziona solo su finestre floating con Mod+left-click-drag e
    // Mod+right-click-drag (configurato nei `binds` sotto).
}


// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// OUTPUT — singolo monitor, auto-detect
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Niri rileva il monitor automaticamente. Sblocca ed edita questo blocco
// solo se vuoi forzare risoluzione/refresh/scale specifici. Per scoprire
// il nome del tuo output, lancia: niri msg outputs
//
// output "eDP-1" {
//     mode "1920x1080@60.000"
//     scale 1.0
//     position x=0 y=0
//     variable-refresh-rate on-demand=true
// }


// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LAYOUT — gap, larghezze colonna, focus ring, border
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

layout {
    gaps 8
    background-color "transparent"
    center-focused-column "never"

    // Larghezze preimpostate cicliche (premi il bind switch-preset-column-width)
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    // Larghezza di default quando si apre una nuova colonna
    default-column-width { proportion 0.5; }

    // Focus ring (l'evidenziatore della finestra attiva)
    focus-ring {
        width 2
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    // Border vero e proprio (off di default, il focus-ring basta)
    border {
        off
    }

    // Indicatore di posizione di inserimento quando muovi colonne
    insert-hint {
        color "#ffc87f80"
    }

    struts {
        // se waybar copre qualcosa, regola qui
        // left 64
        // right 64
    }

    // Empty workspaces sopra il primo (utile in modalità dinamica)
    // empty-workspace-above-first
}

// hyprland: disable_hyprland_logo + disable_splash_rendering
// In niri non c'è logo splash, niente da fare.

// Preferisci finestre senza decorazioni client-side
prefer-no-csd

// Path screenshot (sostituisce screenshot.sh per il bind nativo)
screenshot-path "~/Pictures/Screenshots/screenshot from %Y-%m-%d %H-%M-%S.png"

// Cursor: hyprland aveva no_hardware_cursors per nvidia
cursor {
    hide-when-typing
    hide-after-inactive-ms 2000
}

// Hot corners disattivati per evitare attivazioni accidentali dell'overview
hotkey-overlay {
    skip-at-startup
}


// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SPAWN AT STARTUP — equivalente di exec-once di hyprland
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// === Tenuti perché servono a DMS / al Wayland session ===
// Restart xdg-desktop-portal per screensharing — sostituisce resetxdgportal.sh
spawn-at-startup "sh" "-c" "systemctl --user restart xdg-desktop-portal xdg-desktop-portal-gtk"
spawn-at-startup "sh" "-c" "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP"
spawn-at-startup "sh" "-c" "dbus-update-activation-environment --systemd --all"
spawn-at-startup "sh" "-c" "systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP"
// udiskie: gestione media rimovibili (DMS non lo include)
spawn-at-startup "udiskie" "--no-automount" "--smart-tray"
// cliphist: DMS lo usa sotto, ma il watch va comunque avviato
spawn-at-startup "sh" "-c" "wl-paste --type text --watch cliphist store"
spawn-at-startup "sh" "-c" "wl-paste --type image --watch cliphist store"
// wl-gammarelay: ancora usato per i bind Alt+F8/F9 (warm/cool 3000K)
spawn-at-startup "wl-gammarelay"

// === Rimossi perché DMS li sostituisce ===
//   waybar              → DMS bar
//   dunst               → DMS notifications
//   blueman-applet      → DMS control-center (bluetooth)
//   nm-applet           → DMS control-center (network)
//   polkitkdeauth.sh    → DMS polkit agent
//   batterynotify.sh    → DMS battery notifications
//   awww-daemon + restore → DMS wallpaper engine
//
// === DMS NON va in spawn-at-startup ===
// Lo lanciamo via systemd: `systemctl --user add-wants niri.service dms`
// così parte SOLO quando niri parte. Vedi MIGRATION_NOTES.


// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENVIRONMENT — variabili equivalenti agli `env =` di hyprland.conf
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// NB: niri non espande variabili shell qui. Per il PATH aggiungi
// ~/.local/share/bin nel tuo .zshrc/.bashrc o ~/.profile, NON qui:
// settarlo wholesale qui sovrascriverebbe il resto del PATH.

environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    XDG_SESSION_DESKTOP "niri"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"
    MOZ_ENABLE_WAYLAND "1"
    GDK_SCALE "1"
    // (rimosse le env var nvidia: GBM_BACKEND, __GLX_VENDOR_LIBRARY_NAME,
    //  LIBVA_DRIVER_NAME, __GL_VRR_ALLOWED, NIRI_DISABLE_HARDWARE_CURSORS —
    //  il T470s è Intel HD 620, su iGPU non servono e alcune farebbero danni)
}


// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ANIMAZIONI — adattamento delle bezier "wind/winIn/winOut" di HyDE
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

animations {
    // Globale: 1.0 = velocità nominale. Aumenta per rallentare tutto.
    slowdown 1.0

    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-open {
        duration-ms 200
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
}


// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// WINDOW RULES — porting di tutte le windowrule HyDE (62 regole)
// Match: in niri si usano `app-id` (= class wayland) e `title` (regex).
// Per app X11/xwayland l'app-id potrebbe differire — controlla con:
//   niri msg --json windows
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// --- Regola GLOBALE: blur + corner radius + fix tint focus-ring ---
// 1) Blur globale: grazie a xray niri lo calcola una volta sul wallpaper.
// 2) draw-border-with-background false: fix per la sfumatura azzurra che
//    tracima attraverso le finestre semitrasparenti (Steam, Discord, ecc.).
//    Senza questo, il colore del focus-ring si vede dietro al contenuto
//    trasparente e tinge la finestra di azzurro quando ha il focus.
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
    draw-border-with-background false
    background-effect {
        blur true
    }
}

// --- Browser e editor ---
window-rule {
    match app-id="firefox"
    opacity 0.90
    background-effect { blur true; }
}
window-rule {
    match app-id="^[Bb]rave-browser$"
    opacity 0.90
    background-effect { blur true; }
}
window-rule {
    match app-id="code-oss"
    opacity 0.80
    background-effect { blur true; }
}
window-rule {
    match app-id="^[Cc]ode$"
    opacity 0.80
    background-effect { blur true; }
}
window-rule {
    match app-id="code-url-handler"
    opacity 0.80
    background-effect { blur true; }
}
window-rule {
    match app-id="code-insiders-url-handler"
    opacity 0.80
    background-effect { blur true; }
}

// --- Terminale & file manager ---
window-rule {
    match app-id="kitty"
    opacity 0.80
    background-effect { blur true; }
}
window-rule {
    match app-id="org.kde.dolphin"
    opacity 0.80
    background-effect { blur true; }
}

// --- Tool che vogliamo floating ---
window-rule {
    match app-id="org.kde.ark"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="nwg-look"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="qt5ct"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="qt6ct"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="kvantummanager"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="org.pulseaudio.pavucontrol"
    opacity 0.75
    open-floating true
}
window-rule {
    match app-id="blueman-manager"
    opacity 0.75
    open-floating true
}
window-rule {
    match app-id="nm-applet"
    opacity 0.75
    open-floating true
}
window-rule {
    match app-id="nm-connection-editor"
    opacity 0.75
    open-floating true
}

// --- Polkit & portali ---
window-rule {
    match app-id="org.kde.polkit-kde-authentication-agent-1"
    opacity 0.75
    open-floating true
}
window-rule {
    match app-id="polkit-gnome-authentication-agent-1"
    opacity 0.75
}
window-rule {
    match app-id="org.freedesktop.impl.portal.desktop.gtk"
    opacity 0.75
}
// (rimosso) match app-id="org.freedesktop.impl.portal.desktop.hyprland"
// — non più rilevante, ora usiamo xdg-desktop-portal-gtk

// --- Steam & Spotify ---
window-rule {
    match app-id="^[Ss]team$"
    opacity 0.70
}
window-rule {
    match app-id="steamwebhelper"
    opacity 0.70
}
window-rule {
    match app-id="^[Ss]potify$"
    opacity 0.70
}

// --- App GTK varie ---
window-rule {
    match app-id="com.github.rafostar.Clapper"
    opacity 0.90
    open-floating true
}
window-rule {
    match app-id="com.github.tchx84.Flatseal"
    opacity 0.80
}
window-rule {
    match app-id="hu.kramo.Cartridges"
    opacity 0.80
}
window-rule {
    match app-id="com.obsproject.Studio"
    opacity 0.80
}
window-rule {
    match app-id="gnome-boxes"
    opacity 0.80
}
window-rule {
    match app-id="vesktop"
    opacity 0.80
}
window-rule {
    match app-id="discord"
    opacity 0.80
}
window-rule {
    match app-id="WebCord"
    opacity 0.80
}
window-rule {
    match app-id="ArmCord"
    opacity 0.80
}
window-rule {
    match app-id="app.drey.Warp"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="net.davidotek.pupgui2"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="yad"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="Signal"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="io.github.alainm23.planify"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="io.gitlab.theevilskeleton.Upscaler"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="com.github.unrud.VideoDownloader"
    opacity 0.80
}
window-rule {
    match app-id="io.gitlab.adhami3310.Impression"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="io.missioncenter.MissionCenter"
    opacity 0.80
    open-floating true
}
window-rule {
    match app-id="io.github.flattool.Warehouse"
