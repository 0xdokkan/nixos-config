}

// --- Floating per titolo (modali/dialoghi) ---
window-rule {
    match app-id="org.kde.dolphin" title="^Progress Dialog — Dolphin$"
    open-floating true
}
window-rule {
    match app-id="org.kde.dolphin" title="^Copying — Dolphin$"
    open-floating true
}
window-rule {
    match title="^About Mozilla Firefox$"
    open-floating true
}
window-rule {
    match app-id="firefox" title="^Picture-in-Picture$"
    open-floating true
}
window-rule {
    match app-id="firefox" title="^Library$"
    open-floating true
}
window-rule {
    match app-id="kitty" title="^top$"
    open-floating true
}
window-rule {
    match app-id="kitty" title="^btop$"
    open-floating true
}
window-rule {
    match app-id="kitty" title="^htop$"
    open-floating true
}
window-rule {
    match app-id="vlc"
    open-floating true
}
