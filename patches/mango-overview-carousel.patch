+/* ov_carousel: cover flow. One row, vertically centred: the focused window
+ * big in the middle, the others smaller and smaller towards the sides. The
+ * row is a ring, so moving the focus makes it turn. Windows are ordered by
+ * tag and then by their position on it, so the order does not depend on
+ * which window was focused last. */
+static int compare_carousel_items(const void *a, const void *b) {
+	const Client *ca = *(Client *const *)a;
+	const Client *cb = *(Client *const *)b;
+	int ta = ca->tags ? __builtin_ctz(ca->tags) : 32;
+	int tb = cb->tags ? __builtin_ctz(cb->tags) : 32;
+	if (ta != tb)
+		return ta < tb ? -1 : 1;
+	if (ca->overview_backup_geom.x != cb->overview_backup_geom.x)
+		return ca->overview_backup_geom.x < cb->overview_backup_geom.x ? -1
+																	   : 1;
+	if (ca->overview_backup_geom.y != cb->overview_backup_geom.y)
+		return ca->overview_backup_geom.y < cb->overview_backup_geom.y ? -1
+																	   : 1;
+	if (ca == cb)
+		return 0;
+	return (uintptr_t)ca < (uintptr_t)cb ? -1 : 1;
+}
+
+/* The windows in the row, in ring order, and the index of the focused one
+ * (0 if none is). The caller frees *out. */
+static int overview_carousel_items(Monitor *m, Client ***out, int *focus) {
+	*out = NULL;
+	*focus = 0;
+	if (m->visible_clients <= 0)
+		return 0;
+
+	Client **items = calloc(m->visible_clients, sizeof(Client *));
+	if (!items)
+		return 0;
+
+	int n = 0;
+	Client *c;
+	wl_list_for_each(c, &clients, link) {
+		if (n < (int)m->visible_clients && c->mon == m && VISIBLEON(c, m) &&
+			!c->isunglobal && !client_is_x11_popup(c))
+			items[n++] = c;
+	}
+	if (n == 0) {
+		free(items);
+		return 0;
+	}
+
+	qsort(items, n, sizeof(Client *), compare_carousel_items);
+	for (int i = 0; i < n; i++) {
+		if (items[i] == m->sel) {
+			*focus = i;
+			break;
+		}
+	}
+	*out = items;
+	return n;
+}
+
+/* The next window along the ring in direction dir (1 or -1), skipping the
+ * ones that do not take focus. */
+static Client *overview_carousel_step(Monitor *m, int32_t dir) {
+	Client **items;
+	int focus;
+	int n = overview_carousel_items(m, &items, &focus);
+	Client *c = NULL;
+	for (int k = 1; k < n && !c; k++) {
+		Client *next = items[((focus + dir * k) % n + n) % n];
+		if (!next->nofocus)
+			c = next;
+	}
+	free(items);
+	return c;
+}
+
+void overview_carousel(Monitor *m) {
+	const float center_h = 0.72f; /* of the usable height */
+	const float shrink = 0.72f;	  /* per step away from the centre */
+
+	Client **items;
+	int focus;
+	int n = overview_carousel_items(m, &items, &focus);
+	if (n == 0)
+		return;
+	/* Of the usable width: a wide middle window would leave the sides
+	 * too little room. */
+	float max_w = n > 1 ? 0.42f : 0.6f;
+
+	float edge = (float)config.overviewgappo;
+	float gap = (float)config.overviewgappi;
+	float avail_w = fmaxf(1.0f, m->w.width - 2.0f * edge);
+	float avail_h = fmaxf(1.0f, m->w.height - 2.0f * edge);
+
+	/* Slot p goes from -left_cnt (far left) to right_cnt (far right). */
+	int right_cnt = n / 2;
+	int left_cnt = n - 1 - right_cnt;
+	float *ws = calloc(n, sizeof(float));
+	float *hs = calloc(n, sizeof(float));
+	if (!ws || !hs) {
+		free(items);
+		free(ws);
+		free(hs);
+		return;
+	}
+
+	float side_w[2] = {0.0f, 0.0f}; /* left, right */
+	for (int p = -left_cnt; p <= right_cnt; p++) {
+		Client *c = items[((focus + p) % n + n) % n];
+		float ow = c->overview_backup_geom.width;
+		float oh = c->overview_backup_geom.height;
+		if (ow <= 0 || oh <= 0) {
+			ow = 100.0f;
+			oh = 100.0f;
+		}
+		float k = powf(shrink, (float)abs(p));
+		float h = avail_h * center_h * k;
+		float w = h * (ow / oh);
+		if (w > avail_w * max_w * k) {
+			w = avail_w * max_w * k;
+			h = w * (oh / ow);
+		}
+		ws[p + left_cnt] = w;
+		hs[p + left_cnt] = h;
+		if (p < 0)
+			side_w[0] += w;
+		else if (p > 0)
+			side_w[1] += w;
+	}
+
+	/* The middle window keeps its size: if a side does not fit in its half
+	 * of the screen, both sides shrink by the same factor. */
+	float center_w = ws[left_cnt];
+	float half = avail_w / 2.0f - center_w / 2.0f;
+	/* With many windows the gaps alone would not fit. */
+	if (right_cnt > 0)
+		gap = fminf(gap, half * 0.25f / right_cnt);
+	float scale = 1.0f;
+	int side_cnt[2] = {left_cnt, right_cnt};
+	for (int i = 0; i < 2; i++) {
+		float room = half - gap * side_cnt[i];
+		if (side_w[i] > room)
+			scale = fminf(scale, room / side_w[i]);
+	}
+
+	float mid_x = m->w.x + m->w.width / 2.0f;
+	float mid_y = m->w.y + m->w.height / 2.0f;
+	float left = mid_x - center_w / 2.0f;
+	float right = mid_x + center_w / 2.0f;
+
+	for (int p = 0; p <= right_cnt; p++) {
+		Client *c = items[(focus + p) % n];
+		float k = p == 0 ? 1.0f : scale;
+		float w = fmaxf(1.0f, ws[p + left_cnt] * k);
+		float h = fmaxf(1.0f, hs[p + left_cnt] * k);
+		float x = p == 0 ? left : right + gap;
+		if (p > 0)
+			right = x + w;
+		client_tile_resize(c,
+						   (struct wlr_box){(int)(x + 0.5f),
+											(int)(mid_y - h / 2.0f + 0.5f),
+											(int)w, (int)h},
+						   0);
+	}
+	for (int p = 1; p <= left_cnt; p++) {
+		Client *c = items[((focus - p) % n + n) % n];
+		float w = fmaxf(1.0f, ws[left_cnt - p] * scale);
+		float h = fmaxf(1.0f, hs[left_cnt - p] * scale);
+		left -= gap + w;
+		client_tile_resize(c,
+						   (struct wlr_box){(int)(left + 0.5f),
+											(int)(mid_y - h / 2.0f + 0.5f),
+											(int)w, (int)h},
+						   0);
+	}
+
+	free(items);
+	free(ws);
+	free(hs);
+}
+
 void overview(Monitor *m) {
-	if (config.ov_tab_mode && !m->is_jump_mode && !m->ov_normal_mode) {
+	if (config.ov_carousel && !m->is_jump_mode) {
+		overview_carousel(m);
+	} else if (config.ov_tab_mode && !m->is_jump_mode && !m->ov_normal_mode) {
 		overview_scale_tab(m);
 	} else {
 		overview_scale(m);
